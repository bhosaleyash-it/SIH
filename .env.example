# Copy to .env and fill in for local/demo use or deployment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-app.onrender.com

# SQLite is the default database for local development and demo usage.
# No database URL is required unless you want to override it for hosting.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Optional: use a hosted database via DATABASE_URL instead of the local SQLite file.
# If you prefer explicit DB settings, keep the default SQLite behavior unless you set
# the connection string or a supported database engine in your environment.
